# BillSentry Health - Environment Configuration Template
# Copy this file to .env and fill in the values before running the application

# ==========================================
# Core Application
# ==========================================
APP_NAME="BillSentry Health"
APP_VERSION="1.0.0"
DEBUG=True
API_PREFIX="/api/v1"

# ==========================================
# Security
# ==========================================
# Generate a strong 32-character secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="CHANGE_ME_IN_PRODUCTION_supersecretkey123"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Database & Cache
# ==========================================
# Default is SQLite for local dev. Use PostgreSQL in production.
DATABASE_URL="sqlite:///./billsentry_dev.db"
# REDIS_URL="redis://localhost:6379/0"

# ==========================================
# OCR & AI (Optional for local dev, Required for production)
# ==========================================
OCR_PROVIDER="tesseract"
# Optional: Set this if tesseract is not in your system PATH
# TESSERACT_CMD="/opt/homebrew/bin/tesseract"
# GOOGLE_VISION_API_KEY="your-google-cloud-vision-api-key"

# ==========================================
# Payments (Razorpay)
# ==========================================
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_HERE"
RAZORPAY_KEY_SECRET="YOUR_SECRET_HERE"

# ==========================================
# Storage (AWS S3)
# ==========================================
# Required if you want to store bill PDFs durably in the cloud
# AWS_ACCESS_KEY_ID="your_aws_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret"
# AWS_REGION="ap-south-1"
# S3_BUCKET_NAME="billsentry-uploads"

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3005","https://billsentry.com"]
MAX_UPLOAD_SIZE_MB=15
SYNC_PROCESSING=True
