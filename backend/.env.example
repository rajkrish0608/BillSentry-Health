# ── BillSentry Health – Environment Configuration ──
# Copy this file to .env and fill in your production values.

APP_NAME=BillSentry Health
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://billsentry:billsentry@localhost:5432/billsentry_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_supersecretkey123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=billsentry-uploads

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Upload
MAX_UPLOAD_SIZE_MB=15
